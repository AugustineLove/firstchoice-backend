generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum Role {
  CUSTOMER
  RIDER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DELETED
}

enum RiderAvailability {
  ONLINE
  OFFLINE
  BUSY
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum OrderStatus {
  PENDING
  ACCEPTED
  RIDER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ErrandStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOMO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderType {
  MARKETPLACE
  DELIVERY
  ERRAND
}

enum DeliveryKind {
  PICKUP
  ERRAND
}

enum ErrandPricingMode {
  FIXED
  PER_ITEM
}

// ─── MODELS ──────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  phone        String     @unique
  email        String?    @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  profileImage String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  rider      Rider?
  vendor     Vendor?
  orders     Order[]
  deliveries DeliveryRequest[]
  errands    Errand[]

  fcmToken     String?
  webFcmToken  String?
  fcmUpdatedAt DateTime? @updatedAt

  resetPasswordToken  String?
  resetPasswordExpiry DateTime?

  firebaseUid String? @unique

  vendorRatings  VendorRating[]
  productReviews ProductReview[]

  telegramChatId         String?
  telegramLinkCode       String?   @unique
  telegramLinkCodeExpiry DateTime?

  adminActions      AdminActionLog[]
  manualJobsCreated ManualJob[]

  hotelBookings     HotelBooking[]
  serviceJobs       ServiceJob[]
  rideRequests      RideRequest[]
  propertyEnquiries PropertyEnquiry[]

  proReviews ProfessionalReview[]
  proCalls   ProfessionalCall[]

  termsVersion    String?
  termsAcceptedAt DateTime?
  termsAcceptances TermsAcceptance[]

}

model Rider {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id])
  bikeType         String
  licenseNumber    String?
  availability     RiderAvailability @default(OFFLINE)
  currentLatitude  Float?
  currentLongitude Float?
  totalDeliveries  Int               @default(0)
  rating           Float             @default(0)
  earnings         Float             @default(0)
  createdAt        DateTime          @default(now())

  orders     Order[]
  deliveries DeliveryRequest[]
  manualJobs ManualJob[]
}

model Vendor {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id])
  businessName     String
  businessType     String
  address          String
  phone            String
  logo             String?
  openingHours     Json?
  openingHours_old String?
  status           VendorStatus   @default(PENDING)
  rating           Float          @default(0)
  createdAt        DateTime       @default(now())
  ratings          VendorRating[]
  products         Product[]
  orders           Order[]
  longitude        String?
  latitude         String?
}

model Product {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  // Core
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  images      String[]
  category    String
  available   Boolean  @default(true)

  // Rich fields
  preparationTime Int? // minutes — food/pharmacy
  calories        Int? // food
  weight          Float? // grocery/pharmacy (grams)
  volume          Float? // drinks/pharmacy (ml)
  unit            String? // "kg", "ml", "pcs", "pack", etc.
  brand           String? // grocery/pharmacy/electronics
  expiryInfo      String? // pharmacy/grocery
  sku             String? // electronics/boutique
  sizes           String[] // boutique (XS/S/M/L/XL)
  colors          String[] // boutique
  tags            String[] // spicy, vegan, halal, gluten-free, etc.
  isPopular       Boolean  @default(false)
  isFeatured      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems    OrderItem[]
  variantGroups ProductVariantGroup[]
  addonGroups   ProductAddonGroup[]
  attributes    ProductAttribute[]
  reviews       ProductReview[]
}

model ProductVariantGroup {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // "Size", "Weight", "Volume", "Storage", "Color"
  required  Boolean          @default(true)
  variants  ProductVariant[]
}

model ProductVariant {
  id              String              @id @default(cuid())
  groupId         String
  group           ProductVariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String // "Small", "Medium", "Large", "500g", "256GB", "Midnight Black"
  priceAdjustment Float               @default(0) // +/- from base price
  available       Boolean             @default(true)
  images          String[]            @default([]) // variant-specific gallery, e.g. per-colour shots.
  // Falls back to the parent product's images
  // on the frontend when empty.
}

model ProductAddonGroup {
  id                   String  @id @default(cuid())
  productId            String
  product              Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                 String // "Extras", "Toppings", "Drinks"
  minSelect            Int     @default(0)
  maxSelect            Int     @default(10)
  incrementable        Boolean @default(false)
  incrementMode        String? // "multiple" | "free" | "halves" | "custom"
  customIncrementValue Float? // flat GHS amount added per extra unit when incrementMode == "custom"

  addons ProductAddon[]
}

model ProductAddon {
  id                   String            @id @default(cuid())
  groupId              String
  group                ProductAddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name                 String // "Egg", "Plantain", "Sausage"
  price                Float             @default(0)
  available            Boolean           @default(true)
  incrementable        Boolean           @default(false)
  incrementMode        String? // "multiple" | "free" | "halves" | "custom"
  // Pricing formulas (qty = quantity selected, base = price above):
  //   multiple -> base * qty
  //   free     -> base + (qty - 1) * 1
  //   halves   -> base + (qty - 1) * (base / 2)
  //   custom   -> base + (qty - 1) * customIncrementValue
  customIncrementValue Float? // flat GHS amount added per extra unit when incrementMode == "custom"; always > 0
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String // "Brand", "Manufacturer", "Storage", "Ingredients"
  value     String
}

// Product-level reviews (separate from VendorRating, which rates the
// vendor as a whole). One review per customer per product — enforced
// by the unique constraint, same pattern as VendorRating.
model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  orderId    String? // optional: order this review is tied to, for a future "verified purchase" badge
  rating     Int // 1–5, enforced in the service layer
  comment    String?
  images     String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, customerId])
}

model Order {
  id              String        @id @default(cuid())
  customerId      String
  customer        User          @relation(fields: [customerId], references: [id])
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  riderId         String?
  rider           Rider?        @relation(fields: [riderId], references: [id])
  subtotal        Float
  deliveryFee     Float
  totalAmount     Float
  orderType       OrderType     @default(MARKETPLACE)
  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PENDING)
  recipientName   String?
  recipientPhone  String?
  deliveryAddress String

  imageUrl      String?
  vendorAddress String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items             OrderItem[]
  transaction       Transaction?
  deliveryLatitude  Float?
  deliveryLongitude Float?

  pickupLatitude  Float?
  pickupLongitude Float?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float

  selectedVariants Json? // [{ groupName: "Size", variantName: "Large", priceAdjustment: 5 }]
  selectedAddons   Json? // [{ groupName: "Extras", addonName: "Egg", price: 2 }, ...]
  itemNotes        String? // "No pepper please"
}

model DeliveryRequest {
  id              String  @id @default(cuid())
  customerId      String
  customer        User    @relation(fields: [customerId], references: [id])
  assignedRiderId String?
  rider           Rider?  @relation(fields: [assignedRiderId], references: [id])

  type DeliveryKind @default(PICKUP) // ← new

  pickupAddress   String
  pickupLatitude  Float?
  pickupLongitude Float?

  destinationAddress   String
  destinationLatitude  Float?
  destinationLongitude Float?

  itemDescription     String // for PICKUP; auto-summarized for ERRAND
  errandItems         Json? // ← new: string[] of errand lines
  itemsEstimatedTotal Float  @default(0)
  deliveryFee         Float  @default(0) // ← new: distance-based portion
  errandFee           Float  @default(0) // ← new: fixed or per-item portion
  estimatedFee        Float // = deliveryFee + errandFee (kept for compatibility)

  paymentMethod PaymentMethod  @default(CASH)
  status        DeliveryStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  recipientName  String?
  recipientPhone String?
  imageUrl       String?
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usedAsErrandPickupBy Settings[] // ← new
}

model Settings {
  id                     Int               @id @default(1)
  errandPricingMode      ErrandPricingMode @default(FIXED)
  errandFixedPrice       Float             @default(20)
  errandPerItemPrice     Float             @default(5)
  errandPickupLocationId String?
  errandPickupLocation   Location?         @relation(fields: [errandPickupLocationId], references: [id])

  operatingHours    Json? // { "0": [{start,end}], "1": [...], ... } — null = use defaults
  overrideActive    Boolean   @default(false)
  overrideExpiresAt DateTime? // when the manual "accept orders anyway" window ends

  isClosed      Boolean @default(false)
  closedMessage String?

  updatedAt       DateTime @updatedAt
  enabledServices Json?
  
  termsVersion String?   
  termsUrl     String?
  privacyUrl   String?
  termsSummary String?   

}

model Errand {
  id             String       @id @default(cuid())
  customerId     String
  customer       User         @relation(fields: [customerId], references: [id])
  description    String
  instructions   String?
  budget         Float
  pickupLocation String?
  status         ErrandStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Transaction {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  amount        Float
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  recordedAt    DateTime      @default(now())
}

model VendorRating {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  rating     Int // 1–5, enforced in the service layer
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // one vote per customer per vendor — this is what makes "rate once" work
  @@unique([vendorId, customerId])
}

enum AdminActionType {
  ORDER_STATUS_CHANGE
  ORDER_RIDER_ASSIGN
  DELIVERY_STATUS_CHANGE
  DELIVERY_RIDER_ASSIGN
  VENDOR_STATUS_CHANGE
  VENDOR_CREATED
  VENDOR_PROFILE_UPDATED
  USER_STATUS_CHANGE
  PRODUCT_CREATED
  PRODUCT_DELETED
  BROADCAST_SENT
  USER_PASSWORD_RESET
  RIDE_DRIVER_ASSIGN
  RIDE_STATUS_CHANGE
}

model AdminActionLog {
  id         String          @id @default(cuid())
  adminId    String
  admin      User            @relation(fields: [adminId], references: [id])
  action     AdminActionType
  targetType String? // "Order", "Delivery", "Vendor", "User", "Product"
  targetId   String?
  summary    String // human-readable one-liner shown in the feed
  metadata   Json? // before/after values, riderId, etc.
  createdAt  DateTime        @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum ManualJobStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  CANCELLED
}

model ManualJob {
  id              String  @id @default(cuid())
  createdById     String
  createdBy       User    @relation(fields: [createdById], references: [id])
  assignedRiderId String?
  rider           Rider?  @relation(fields: [assignedRiderId], references: [id])

  customerName  String?
  customerPhone String?

  pickupAddress   String
  pickupLatitude  Float?
  pickupLongitude Float?

  destinationAddress   String
  destinationLatitude  Float?
  destinationLongitude Float?

  itemDescription String?
  amount          Float         @default(0)
  paymentMethod   PaymentMethod @default(CASH)

  status  ManualJobStatus @default(PENDING)
  rawNote String? // the pasted blob, kept for audit/reference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ServiceJobStatus {
  PENDING
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RideVehicleType {
  TRICYCLE
  MOTORBIKE
  TAXI
  TRUCK
  OTHER
}

enum RideStatus {
  PENDING
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PropertyType {
  SINGLE_ROOM
  CHAMBER_AND_HALL
  SELF_CONTAINED
  APARTMENT
  HOUSE
  SHOP_STORE
  OTHER
}

enum EnquiryStatus {
  NEW
  CONTACTED
  VIEWING_SCHEDULED
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  REJECTED
}

model ProfessionalReview {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User         @relation(fields: [customerId], references: [id])
  rating         Int // 1-5, enforced in the service layer
  comment        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([professionalId, customerId])
}

model ProfessionalCall {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User         @relation(fields: [customerId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([professionalId, customerId])
}

model Hotel {
  id          String        @id @default(cuid())
  name        String
  description String?
  address     String
  area        String?
  latitude    Float?
  longitude   Float?
  phone       String
  images      String[]      @default([])
  amenities   String[]      @default([])
  rating      Float         @default(0)
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  roomTypes RoomType[]
  bookings  HotelBooking[]

  @@index([status])
}

model RoomType {
  id            String   @id @default(cuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name          String // "Standard", "Executive", "Self-contained"
  description   String?
  pricePerNight Float
  capacity      Int      @default(2)
  totalRooms    Int      @default(1) // how many of this type exist
  images        String[] @default([])
  amenities     String[] @default([])
  available     Boolean  @default(true)

  bookings HotelBooking[]
}

model HotelBooking {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  hotelId    String
  hotel      Hotel    @relation(fields: [hotelId], references: [id])
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  checkIn     DateTime
  checkOut    DateTime
  guests      Int      @default(1)
  rooms       Int      @default(1)
  nights      Int
  totalAmount Float // pricePerNight * nights * rooms, frozen at booking time

  guestName  String
  guestPhone String
  notes      String?

  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([hotelId, checkIn, checkOut])
  @@index([customerId])
}

model Trade {
  id        String  @id @default(cuid())
  name      String  @unique // "Electrician"
  icon      String? // emoji or icon key
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  professionals Professional[]
  jobs          ServiceJob[]
}

model Professional {
  id           String            @id @default(cuid())
  name         String
  phone        String
  photo        String?
  bio          String?
  area         String?
  whatsapp     String?
  yearsExp     Int?
  priceNote    String?
  rating       Float             @default(0)
  reviewCount  Int               @default(0)
  totalJobs    Int               @default(0)
  verified     Boolean           @default(false)
  availability RiderAvailability @default(OFFLINE) // reuse ONLINE/BUSY/OFFLINE
  status       ListingStatus     @default(DRAFT)
  createdAt    DateTime          @default(now())

  trades  Trade[]
  reviews ProfessionalReview[]
  calls   ProfessionalCall[]
  jobs    ServiceJob[]

  @@index([status])
}

model ServiceJob {
  id             String        @id @default(cuid())
  customerId     String
  customer       User          @relation(fields: [customerId], references: [id])
  tradeId        String
  trade          Trade         @relation(fields: [tradeId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])

  description   String
  address       String
  latitude      Float?
  longitude     Float?
  isUrgent      Boolean   @default(false)
  preferredTime DateTime?
  imageUrls     String[]  @default([])

  quotedAmount  Float? // pro/admin quotes after seeing the description
  finalAmount   Float?
  paymentMethod PaymentMethod    @default(CASH)
  status        ServiceJobStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([customerId])
}

model Driver {
  id                 String            @id @default(cuid())
  name               String
  phone              String
  photo              String?
  vehicleType        RideVehicleType
  whatsapp           String?
  area               String?

  vehicleDescription String? // "Red Aboboyaa, 3-seater"
  plateNumber        String?
  rating             Float             @default(0)
  totalRides         Int               @default(0)
  availability       RiderAvailability @default(OFFLINE)
  currentLatitude    Float?
  currentLongitude   Float?
  verified           Boolean           @default(false)
  status             ListingStatus     @default(DRAFT)
  createdAt          DateTime          @default(now())

  rides RideRequest[]
}

// Admin-editable fares per vehicle type — no redeploy to change prices.
model RideRate {
  vehicleType RideVehicleType @id
  baseFare    Float           @default(5)
  perKm       Float           @default(2)
  minFare     Float           @default(5)
  active      Boolean         @default(true)
}

model RideRequest {
  id         String  @id @default(cuid())
  customerId String
  customer   User    @relation(fields: [customerId], references: [id])
  driverId   String?
  driver     Driver? @relation(fields: [driverId], references: [id])

  vehicleType          RideVehicleType
  passengers           Int             @default(1)
  pickupAddress        String
  pickupLatitude       Float?
  pickupLongitude      Float?
  destinationAddress   String
  destinationLatitude  Float?
  destinationLongitude Float?
  notes                String? // e.g. "I have luggage", "need a truck for 20 bags of cement"

  estimatedFare Float
  finalFare     Float?
  paymentMethod PaymentMethod @default(CASH)
  status        RideStatus    @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([customerId])
}

model Property {
  id            String       @id @default(cuid())
  title         String
  description   String?
  type          PropertyType
  rentAmount    Float // per month, GHS
  advanceMonths Int          @default(12) // how many months landlord asks upfront
  bedrooms      Int?
  bathrooms     Int?
  address       String
  area          String?
  latitude      Float?
  longitude     Float?
  images        String[]     @default([])
  amenities     String[]     @default([]) // "Water", "Prepaid meter", "Fenced", "Tiled"

  // Landlord contact is held server-side and only released after an enquiry
  contactName  String
  contactPhone String

  status    ListingStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  enquiries PropertyEnquiry[]

  @@index([status, type])
}

model PropertyEnquiry {
  id               String        @id @default(cuid())
  propertyId       String
  property         Property      @relation(fields: [propertyId], references: [id])
  customerId       String
  customer         User          @relation(fields: [customerId], references: [id])
  message          String?
  preferredViewing DateTime?
  status           EnquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())

  @@unique([propertyId, customerId]) // one live enquiry per person per listing
}


model TermsAcceptance {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  version     String            // e.g. "2026-11-01"
  documents   String[]          // ["terms", "privacy"]
  appVersion  String?
  platform    String?           // android / ios / web
  ipAddress   String?
  acceptedAt  DateTime @default(now())

  @@unique([userId, version])
  @@index([version])
}