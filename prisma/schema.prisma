generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum Role {
  CUSTOMER
  RIDER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum RiderAvailability {
  ONLINE
  OFFLINE
  BUSY
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ErrandStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOMO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderType {
  MARKETPLACE
  DELIVERY
  ERRAND
}

// ─── MODELS ──────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  phone        String     @unique
  email        String?    @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  profileImage String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  rider        Rider?
  vendor       Vendor?
  orders       Order[]
  deliveries   DeliveryRequest[]
  errands      Errand[]

  fcmToken   String?
  fcmUpdatedAt DateTime? @updatedAt

}

model Rider {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id])
  bikeType         String
  licenseNumber    String?
  availability     RiderAvailability @default(OFFLINE)
  currentLatitude  Float?
  currentLongitude Float?
  totalDeliveries  Int               @default(0)
  rating           Float             @default(0)
  earnings         Float             @default(0)
  createdAt        DateTime          @default(now())

  orders           Order[]
  deliveries       DeliveryRequest[]
}

model Vendor {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id])
  businessName String
  businessType String
  address      String
  phone        String
  logo         String?
  openingHours String?
  status       VendorStatus @default(PENDING)
  rating       Float        @default(0)
  createdAt    DateTime     @default(now())

  products     Product[]
  orders       Order[]
}

model Product {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  // Core
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  images      String[]
  category    String
  available   Boolean  @default(true)

  // Rich fields
  preparationTime Int?      // minutes — food/pharmacy
  calories        Int?      // food
  weight          Float?    // grocery/pharmacy (grams)
  volume          Float?    // drinks/pharmacy (ml)
  unit            String?   // "kg", "ml", "pcs", "pack", etc.
  brand           String?   // grocery/pharmacy/electronics
  expiryInfo      String?   // pharmacy/grocery
  sku             String?   // electronics/boutique
  sizes           String[]  // boutique (XS/S/M/L/XL)
  colors          String[]  // boutique
  tags            String[]  // spicy, vegan, halal, gluten-free, etc.
  isPopular       Boolean   @default(false)
  isFeatured      Boolean   @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems      OrderItem[]
  variantGroups   ProductVariantGroup[]
  addonGroups     ProductAddonGroup[]
  attributes      ProductAttribute[]
}

model ProductVariantGroup {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String           // "Size", "Weight", "Volume"
  required  Boolean          @default(true)
  variants  ProductVariant[]
}

model ProductVariant {
  id        String              @id @default(cuid())
  groupId   String
  group     ProductVariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String              // "Small", "Medium", "Large", "500g"
  priceAdjustment Float         @default(0) // +/- from base price
  available Boolean             @default(true)
}

model ProductAddonGroup {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String         // "Extras", "Toppings", "Drinks"
  minSelect  Int            @default(0)
  maxSelect  Int            @default(10)
  incrementable Boolean   @default(false)
  incrementMode String?

  addons     ProductAddon[]
}

model ProductAddon {
  id        String            @id @default(cuid())
  groupId   String
  group     ProductAddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String            // "Egg", "Plantain", "Sausage"
  price     Float             @default(0)
  available Boolean           @default(true)
  incrementable Boolean       @default(false)
  incrementMode String?
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String  // "Brand", "Manufacturer", "Storage", "Ingredients"
  value     String
}

model Order {
  id              String        @id @default(cuid())
  customerId      String
  customer        User          @relation(fields: [customerId], references: [id])
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  riderId         String?
  rider           Rider?        @relation(fields: [riderId], references: [id])
  subtotal        Float
  deliveryFee     Float
  totalAmount     Float
  orderType       OrderType     @default(MARKETPLACE)
  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PENDING)
  recipientName   String?
  recipientPhone  String?
  deliveryAddress String
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]
  transaction     Transaction?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float

  selectedVariants Json?  // [{ groupName: "Size", variantName: "Large", priceAdjustment: 5 }]
  selectedAddons   Json?  // [{ groupName: "Extras", addonName: "Egg", price: 2 }, ...]
  itemNotes        String? // "No pepper please"
}

model DeliveryRequest {
  id                  String         @id @default(cuid())
  customerId          String
  customer            User           @relation(fields: [customerId], references: [id])
  assignedRiderId     String?
  rider               Rider?         @relation(fields: [assignedRiderId], references: [id])

  pickupAddress       String
  pickupLatitude      Float?          // ← new
  pickupLongitude     Float?          // ← new

  destinationAddress  String
  destinationLatitude  Float?         // ← new
  destinationLongitude Float?         // ← new

  itemDescription     String
  estimatedFee        Float
  paymentMethod       PaymentMethod  @default(CASH)   // ← was missing
  status              DeliveryStatus @default(PENDING)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Location {
  id        String   @id @default(cuid())
  name      String                          // e.g. "Agona Nkwanta Market"
  address   String                          // full address string shown to user
  latitude  Float
  longitude Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Errand {
  id               String       @id @default(cuid())
  customerId       String
  customer         User         @relation(fields: [customerId], references: [id])
  description      String
  instructions     String?
  budget           Float
  pickupLocation   String?
  status           ErrandStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Transaction {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  amount        Float
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  recordedAt    DateTime      @default(now())
}